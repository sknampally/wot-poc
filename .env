# ====== CORE PATHS / MODES ======
USE_MANUAL_ONLY=false             # we want real web search for the POC
MAX_URLS_PER_PROJECT=25

# ====== SEARCHER (HTML DDG/Bing/serpAPI fallback) ======
SEARCH_REGION=us-en               # for logs only
SEARCH_SAFESEARCH=moderate
SEARCH_BACKOFF_SECONDS=4          # increase to 3-4 if you see throttling
SEARCH_UA=Mozilla/5.0 (Macintosh; Intel Mac OS X 13_6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=4c7346233885e64b78a90a58b5fe24ed3a124f6c88554d6de06eaf662ff8fb2e        # set this in runtime
SERPAPI_ENGINE=google             # or bing, duckduckgo

# ====== SCRAPER ======
SCRAPE_CONNECT_TIMEOUT=10
SCRAPE_READ_TIMEOUT=25
SCRAPE_MAX_RETRIES=3
SCRAPE_BACKOFF=0.5
SCRAPE_MAX_BYTES=2000000
SCRAPE_SLEEP_BETWEEN=0.4
SCRAPE_UA=Mozilla/5.0 (Macintosh; Intel Mac OS X 13_6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# ====== LLM PROVIDER SWITCH (CLI can override these) ======
LLM_PROVIDER=openai               # openai | ollama
# -- OpenAI (used when LLM_PROVIDER=openai) --
OPENAI_API_KEY=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                   # set this in runtime
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
OPENAI_MAX_OUTPUT_TOKENS=1200

# -- Ollama (used when LLM_PROVIDER=ollama) --
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
